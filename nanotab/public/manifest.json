{
  "manifest_version": 3,
  "name": "腾龙起始页",
  "version": "1.0.2",
  "description": "一个纯本地、断网可用的极简浏览器起始页。",
  "minimum_chrome_version": "100",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "腾龙起始页",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "downloads"]
}
